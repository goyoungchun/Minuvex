cmake_minimum_required(VERSION 3.24)
if(NOT OUTPUT_ROOT)
    message(FATAL_ERROR "Pass an OUTPUT_ROOT for the package contract fixtures.")
endif()
file(MAKE_DIRECTORY "${OUTPUT_ROOT}")
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/VerifyArchive.cmake")
set(_archive "${OUTPUT_ROOT}/fixture.zip")
file(WRITE "${_archive}" "synthetic checksum fixture; not an SDK")
file(SHA256 "${_archive}" _digest)
file(WRITE "${_archive}.sha256" "${_digest}  fixture.zip\n")
minuvex_verify_archive("${_archive}")
file(APPEND "${_archive}" "tampered")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DARCHIVE=${_archive}" -P "${CMAKE_CURRENT_LIST_DIR}/../../cmake/VerifyArchive.cmake"
    RESULT_VARIABLE _result OUTPUT_QUIET ERROR_QUIET)
if(_result EQUAL 0)
    message(FATAL_ERROR "Tampered package checksum was accepted.")
endif()
# Simulate a multi-config invocation: the requested config must beat build type.
set(_sdk_package_base fixture-sdk)
set(CMAKE_BUILD_TYPE Release)
set(CPACK_BUILD_CONFIG Debug)
set(_options "${OUTPUT_ROOT}/CPackOptions.cmake")
configure_file("${CMAKE_CURRENT_LIST_DIR}/../../cmake/CPackOptions.cmake.in" "${_options}" @ONLY)
include("${_options}")
if(NOT CPACK_PACKAGE_FILE_NAME STREQUAL "fixture-sdk-Debug")
    message(FATAL_ERROR "CPack ignored its selected multi-config payload.")
endif()
message(STATUS "3 package contract checks passed: checksum acceptance/tamper rejection, multi-config name.")
