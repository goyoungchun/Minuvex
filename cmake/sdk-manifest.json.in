{
  "format": "MinuvexSdk",
  "version": "@PROJECT_VERSION@",
  "flavor": "@MINUVEX_PACKAGE_FLAVOR@",
  "system": "@CMAKE_SYSTEM_NAME@",
  "processor": "@CMAKE_SYSTEM_PROCESSOR@",
  "compiler": "@CMAKE_CXX_COMPILER_ID@-@CMAKE_CXX_COMPILER_VERSION@",
  "pointerBytes": @CMAKE_SIZEOF_VOID_P@,
  "configuration": "$<CONFIG>",
  "runtime": "@MINUVEX_SDK_RUNTIME@",
  "sceneVersion": 8,
  "poseVersion": 1,
  "qualityVersion": 1,
  "importVersion": 6,
  "linkage": "static",
  "abiPolicy": "Rebuild consumers with the same compiler toolset, architecture, configuration and C++ runtime.",
  "publication": "local SDK artifact; Markdown installation is opt-in"
}
