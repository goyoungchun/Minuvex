# WebGL2 uses CPU Morph and the same static/skinned/material shaders.
file(STRINGS "${INPUT}" lines)
set(result "")
set(skip OFF)
foreach(line IN LISTS lines)
    if(line MATCHES "^@(block morph_common|vs morph_)")
        set(skip ON)
    elseif(skip AND line STREQUAL "@end")
        set(skip OFF)
    elseif(NOT skip AND NOT line MATCHES "^@program morph_")
        string(REPLACE "joint_matrices[128]" "joint_matrices[48]" line "${line}")
        # The pinned SPIRV-Cross flattener emits signed offset literals; cast
        # joint indices before flattening to keep GLSL ES integer types valid.
        foreach(axis x y z w)
            string(REPLACE "joint_matrices[joint_indices.${axis}]" "joint_matrices[int(joint_indices.${axis})]" line "${line}")
        endforeach()
        string(APPEND result "${line}\n")
        if(line MATCHES "^@vs ")
            if(INPUT MATCHES "present.glsl$")
                string(APPEND result "@glsl_options fixup_clipspace flip_vert_y\n")
            else()
                string(APPEND result "@glsl_options fixup_clipspace\n")
            endif()
        endif()
    endif()
endforeach()
file(WRITE "${OUTPUT}" "${result}")
