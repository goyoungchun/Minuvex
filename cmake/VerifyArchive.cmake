cmake_minimum_required(VERSION 3.24)
function(minvex_verify_archive archive)
    if(NOT EXISTS "${archive}" OR NOT EXISTS "${archive}.sha256")
        message(FATAL_ERROR "SDK archive and SHA-256 sidecar are both required: ${archive}")
    endif()
    file(READ "${archive}.sha256" _checksum)
    string(REGEX MATCH "^[0-9A-Fa-f]+" _expected "${_checksum}")
    string(LENGTH "${_expected}" _length)
    file(SHA256 "${archive}" _actual)
    string(TOLOWER "${_expected}" _expected)
    if(NOT _length EQUAL 64 OR NOT _expected STREQUAL _actual)
        message(FATAL_ERROR "SDK SHA-256 checksum mismatch: ${archive}")
    endif()
endfunction()
if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    minvex_verify_archive("${ARCHIVE}")
endif()
