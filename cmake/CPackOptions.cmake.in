# Evaluated at CPack time, when -C selects the actual multi-config payload.
if(NOT CPACK_BUILD_CONFIG)
    set(CPACK_BUILD_CONFIG "@CMAKE_BUILD_TYPE@")
endif()
if(NOT CPACK_BUILD_CONFIG)
    message(FATAL_ERROR "Select the SDK build configuration with cpack -C <configuration>.")
endif()
set(CPACK_PACKAGE_FILE_NAME "@_sdk_package_base@-${CPACK_BUILD_CONFIG}")
