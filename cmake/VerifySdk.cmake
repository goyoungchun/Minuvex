cmake_minimum_required(VERSION 3.24)
# Explicit release gate, deliberately not registered in the compact CTest suite.
foreach(_required BUILD_DIR)
    if(NOT DEFINED ${_required})
        message(FATAL_ERROR "Pass -D${_required}=<configured SDK build>")
    endif()
endforeach()
if(NOT CONFIG)
    set(CONFIG Release)
endif()
function(run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE _result)
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "SDK verification failed (${_result}): ${ARGV}")
    endif()
endfunction()
file(REAL_PATH "${BUILD_DIR}" BUILD_DIR)
file(STRINGS "${BUILD_DIR}/CMakeCache.txt" _data_entry REGEX "^CMAKE_INSTALL_DATADIR:[^=]+=")
string(REGEX REPLACE "^CMAKE_INSTALL_DATADIR:[^=]+=" "" _data_dir "${_data_entry}")
if(NOT _data_dir)
    # GNUInstallDirs may leave DATADIR's cache entry empty while its effective
    # value follows DATAROOTDIR (notably when reusing a newer CMake cache).
    file(STRINGS "${BUILD_DIR}/CMakeCache.txt" _data_entry REGEX "^CMAKE_INSTALL_DATAROOTDIR:[^=]+=")
    string(REGEX REPLACE "^CMAKE_INSTALL_DATAROOTDIR:[^=]+=" "" _data_dir "${_data_entry}")
endif()
if(NOT _data_dir OR IS_ABSOLUTE "${_data_dir}" OR _data_dir MATCHES "(^|[/\\\\])\\.\\.([/\\\\]|$)")
    message(FATAL_ERROR "SDK verification requires a relative CMAKE_INSTALL_DATADIR within the prefix.")
endif()
string(TIMESTAMP _stamp "%Y%m%d%H%M%S")
string(RANDOM LENGTH 6 ALPHABET 0123456789abcdef _nonce)
set(_root "${BUILD_DIR}/sdk-check-${CONFIG}-${_stamp}-${_nonce}")
set(_stage "${_root}/original")
set(_relocated "${_root}/relocated SDK")
run("${CMAKE_COMMAND}" --install "${BUILD_DIR}" --config "${CONFIG}" --prefix "${_stage}")
# Both absolute paths are fixed children of this build's fresh verification root.
cmake_path(IS_PREFIX BUILD_DIR "${_stage}" NORMALIZE _source_safe)
cmake_path(IS_PREFIX BUILD_DIR "${_relocated}" NORMALIZE _target_safe)
if(NOT _source_safe OR NOT _target_safe)
    message(FATAL_ERROR "SDK relocation escaped the build directory")
endif()
file(RENAME "${_stage}" "${_relocated}")
file(GLOB_RECURSE _configs "${_relocated}/*MinuvexConfig.cmake")
list(GET _configs 0 _config)
get_filename_component(_config_dir "${_config}" DIRECTORY)
file(GLOB _cmake_files "${_config_dir}/*.cmake")
foreach(_file IN LISTS _cmake_files)
    file(READ "${_file}" _contents)
    string(FIND "${_contents}" "${BUILD_DIR}" _leak)
    if(NOT _leak EQUAL -1 OR _contents MATCHES "_deps[/\\\\]")
        message(FATAL_ERROR "Build/dependency path leaked into ${_file}")
    endif()
    file(STRINGS "${BUILD_DIR}/CMakeCache.txt" _source_entry REGEX "^CMAKE_HOME_DIRECTORY:INTERNAL=")
    string(REPLACE "CMAKE_HOME_DIRECTORY:INTERNAL=" "" _source_dir "${_source_entry}")
    string(FIND "${_contents}" "${_source_dir}" _source_leak)
    if(NOT _source_leak EQUAL -1)
        message(FATAL_ERROR "Source path leaked into ${_file}")
    endif()
endforeach()
function(expect_missing name requirement)
    set(_probe "${_root}/${name}")
    file(MAKE_DIRECTORY "${_probe}")
    file(WRITE "${_probe}/CMakeLists.txt" "cmake_minimum_required(VERSION 3.24)\nproject(SdkNegativeProbe LANGUAGES CXX)\nfind_package(Minuvex ${requirement} CONFIG REQUIRED)\n")
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${_probe}" -B "${_probe}/build"
        -G "${GENERATOR}" "-DMinuvex_DIR=${_config_dir}" -DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF
        RESULT_VARIABLE _result OUTPUT_QUIET ERROR_QUIET)
    if(_result EQUAL 0)
        message(FATAL_ERROR "Incorrectly accepted unavailable package requirement: ${requirement}")
    endif()
endfunction()
if(NOT GENERATOR)
    file(STRINGS "${BUILD_DIR}/CMakeCache.txt" _generator_entry REGEX "^CMAKE_GENERATOR:INTERNAL=")
    string(REPLACE "CMAKE_GENERATOR:INTERNAL=" "" GENERATOR "${_generator_entry}")
endif()
expect_missing(future-major "2")
expect_missing(unknown-component "1 COMPONENTS nonexistent")
set(_recovery "${_root}/find-recovery")
file(MAKE_DIRECTORY "${_recovery}")
file(WRITE "${_recovery}/CMakeLists.txt" "cmake_minimum_required(VERSION 3.24)\nproject(SdkFindRecovery LANGUAGES CXX)\nfind_package(Minuvex 1 QUIET CONFIG COMPONENTS nonexistent)\nif(Minuvex_FOUND)\n message(FATAL_ERROR \"Unknown required component accepted\")\nendif()\nfind_package(Minuvex 1 CONFIG REQUIRED COMPONENTS core)\n")
run("${CMAKE_COMMAND}" -S "${_recovery}" -B "${_recovery}/build" -G "${GENERATOR}"
    "-DMinuvex_DIR=${_config_dir}" -DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF)
set(_share "${_relocated}/${_data_dir}/minuvex")
file(READ "${_share}/sdk-manifest.json" _manifest)
string(JSON _flavor GET "${_manifest}" flavor)
if(_flavor STREQUAL "cpu")
    expect_missing(cpu-graphics "1 COMPONENTS graphics")
endif()
set(_consumer "${_root}/consumer")
set(_options)
if(RUN_DESKTOP)
    list(APPEND _options -DMINUVEX_SDK_BUILD_VIEWER=ON -DMINUVEX_SDK_BUILD_EMBEDDED_HOST=ON)
endif()
if(NOT GENERATOR)
    set(GENERATOR Ninja)
endif()
run("${CMAKE_COMMAND}" -S "${_share}/examples/SdkConsumer" -B "${_consumer}"
    -G "${GENERATOR}" "-DCMAKE_BUILD_TYPE=${CONFIG}" "-DMinuvex_DIR=${_config_dir}"
    -DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF ${_options})
run("${CMAKE_COMMAND}" --build "${_consumer}" --config "${CONFIG}" --parallel 4)
set(_bin "${_consumer}")
if(WIN32)
    set(_exe .exe)
endif()
if(EXISTS "${_consumer}/${CONFIG}/minuvex_sdk_cpu${_exe}")
    set(_bin "${_consumer}/${CONFIG}")
endif()
set(_model "${_share}/examples/assets/SharedBox.glb")
run("${_bin}/minuvex_sdk_cpu${_exe}" "${_model}" "${_root}/output")
if(RUN_DESKTOP)
    run("${_bin}/minuvex_sdk_viewer${_exe}" "${_model}")
    run("${_bin}/minuvex_sdk_effects${_exe}" --frames 3)
    run("${_bin}/minuvex_sdk_host${_exe}" --smoke-test)
endif()
message(STATUS "Relocated SDK and independent consumer verified: ${_relocated}")
