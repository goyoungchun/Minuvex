cmake_minimum_required(VERSION 3.24)
# Explicit release gate, deliberately not registered in the compact CTest suite.
include("${CMAKE_CURRENT_LIST_DIR}/VerifyArchive.cmake")
foreach(_required BUILD_DIR)
    if(NOT DEFINED ${_required})
        message(FATAL_ERROR "Pass -D${_required}=<configured SDK build>")
    endif()
endforeach()
if(NOT CONFIG)
    set(CONFIG Release)
endif()
function(run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE _result)
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "SDK verification failed (${_result}): ${ARGV}")
    endif()
endfunction()
file(REAL_PATH "${BUILD_DIR}" BUILD_DIR)
file(STRINGS "${BUILD_DIR}/CMakeCache.txt" _data_entry REGEX "^CMAKE_INSTALL_DATADIR:[^=]+=")
string(REGEX REPLACE "^CMAKE_INSTALL_DATADIR:[^=]+=" "" _data_dir "${_data_entry}")
if(NOT _data_dir)
    # GNUInstallDirs may leave DATADIR's cache entry empty while its effective
    # value follows DATAROOTDIR (notably when reusing a newer CMake cache).
    file(STRINGS "${BUILD_DIR}/CMakeCache.txt" _data_entry REGEX "^CMAKE_INSTALL_DATAROOTDIR:[^=]+=")
    string(REGEX REPLACE "^CMAKE_INSTALL_DATAROOTDIR:[^=]+=" "" _data_dir "${_data_entry}")
endif()
if(NOT _data_dir OR IS_ABSOLUTE "${_data_dir}" OR _data_dir MATCHES "(^|[/\\\\])\\.\\.([/\\\\]|$)")
    message(FATAL_ERROR "SDK verification requires a relative CMAKE_INSTALL_DATADIR within the prefix.")
endif()
string(TIMESTAMP _stamp "%Y%m%d%H%M%S")
string(RANDOM LENGTH 6 ALPHABET 0123456789abcdef _nonce)
set(_root "${BUILD_DIR}/sdk-check-${CONFIG}-${_stamp}-${_nonce}")
set(_stage "${_root}/original")
set(_relocated "${_root}/relocated SDK")
if(PACKAGE)
    get_filename_component(_cmake_bin "${CMAKE_COMMAND}" DIRECTORY)
    find_program(_cpack NAMES cpack HINTS "${_cmake_bin}" REQUIRED)
    run("${_cpack}" --config "${BUILD_DIR}/CPackConfig.cmake" -C "${CONFIG}" -B "${_root}/packages")
    file(GLOB _archives "${_root}/packages/*.zip" "${_root}/packages/*.tar.gz")
    list(LENGTH _archives _count)
    if(NOT _count EQUAL 1)
        message(FATAL_ERROR "Expected exactly one platform SDK archive, got ${_count}.")
    endif()
    list(GET _archives 0 _archive)
    minuvex_verify_archive("${_archive}")
    file(ARCHIVE_EXTRACT INPUT "${_archive}" DESTINATION "${_stage}")
    file(GLOB _payloads "${_stage}/*")
    list(LENGTH _payloads _count)
    if(NOT _count EQUAL 1)
        message(FATAL_ERROR "SDK archive must contain one top-level payload directory.")
    endif()
    list(GET _payloads 0 _payload)
else()
    run("${CMAKE_COMMAND}" --install "${BUILD_DIR}" --config "${CONFIG}" --prefix "${_stage}")
    set(_payload "${_stage}")
endif()
# Both absolute paths are fixed children of this build's fresh verification root.
file(REAL_PATH "${_payload}" _payload)
cmake_path(IS_PREFIX BUILD_DIR "${_payload}" NORMALIZE _source_safe)
cmake_path(IS_PREFIX BUILD_DIR "${_relocated}" NORMALIZE _target_safe)
if(NOT _source_safe OR NOT _target_safe)
    message(FATAL_ERROR "SDK relocation escaped the build directory")
endif()
file(RENAME "${_payload}" "${_relocated}")
file(GLOB_RECURSE _configs "${_relocated}/*MinuvexConfig.cmake")
list(LENGTH _configs _count)
if(NOT _count EQUAL 1)
    message(FATAL_ERROR "SDK must provide exactly one MinuvexConfig.cmake.")
endif()
list(GET _configs 0 _config)
get_filename_component(_config_dir "${_config}" DIRECTORY)
file(GLOB _cmake_files "${_config_dir}/*.cmake")
foreach(_file IN LISTS _cmake_files)
    file(READ "${_file}" _contents)
    string(FIND "${_contents}" "${BUILD_DIR}" _leak)
    if(NOT _leak EQUAL -1 OR _contents MATCHES "_deps[/\\\\]")
        message(FATAL_ERROR "Build/dependency path leaked into ${_file}")
    endif()
    file(STRINGS "${BUILD_DIR}/CMakeCache.txt" _source_entry REGEX "^CMAKE_HOME_DIRECTORY:INTERNAL=")
    string(REPLACE "CMAKE_HOME_DIRECTORY:INTERNAL=" "" _source_dir "${_source_entry}")
    string(FIND "${_contents}" "${_source_dir}" _source_leak)
    if(NOT _source_leak EQUAL -1)
        message(FATAL_ERROR "Source path leaked into ${_file}")
    endif()
endforeach()
function(expect_missing name requirement)
    set(_probe "${_root}/${name}")
    file(MAKE_DIRECTORY "${_probe}")
    file(WRITE "${_probe}/CMakeLists.txt" "cmake_minimum_required(VERSION 3.24)\nproject(SdkNegativeProbe LANGUAGES CXX)\n${ARGN}\nfind_package(Minuvex ${requirement} CONFIG REQUIRED)\n")
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${_probe}" -B "${_probe}/build"
        -G "${GENERATOR}" "-DCMAKE_BUILD_TYPE=${CONFIG}" "-DMinuvex_DIR=${_config_dir}" -DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF
        RESULT_VARIABLE _result OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr)
    if(_result EQUAL 0)
        message(FATAL_ERROR "Incorrectly accepted unavailable package requirement: ${requirement}")
    endif()
    set(_reason "")
    if(name STREQUAL "configuration")
        set(_reason "Minuvex has configurations")
    elseif(name STREQUAL "runtime")
        set(_reason "Minuvex MSVC runtime")
    elseif(name STREQUAL "pointer-width")
        # CMake's generated version file can reject architecture before Config.
        set(_reason "pointer width differs|[0-9]+bit")
    elseif(name STREQUAL "unknown-component")
        set(_reason "Unknown Minuvex component")
    elseif(name STREQUAL "cpu-graphics")
        set(_reason "CPU-only SDK")
    endif()
    if(_reason AND NOT "${_stdout}${_stderr}" MATCHES "${_reason}")
        message(FATAL_ERROR "SDK probe ${name} failed for an unexpected reason: ${_stdout}${_stderr}")
    endif()
endfunction()
if(NOT GENERATOR)
    file(STRINGS "${BUILD_DIR}/CMakeCache.txt" _generator_entry REGEX "^CMAKE_GENERATOR:INTERNAL=")
    string(REPLACE "CMAKE_GENERATOR:INTERNAL=" "" GENERATOR "${_generator_entry}")
endif()
expect_missing(future-major "2")
expect_missing(future-minor "1.99")
expect_missing(unknown-component "1 COMPONENTS nonexistent")
expect_missing(pointer-width "1 COMPONENTS core" "set(CMAKE_SIZEOF_VOID_P 123)")
if(CONFIG STREQUAL "Debug")
    set(_wrong_config Release)
else()
    set(_wrong_config Debug)
endif()
expect_missing(configuration "1 COMPONENTS core" "set(CMAKE_CONFIGURATION_TYPES \"\")\nset(CMAKE_BUILD_TYPE ${_wrong_config})")
file(STRINGS "${BUILD_DIR}/CMakeCache.txt" _msvc_entry REGEX "^CMAKE_CXX_COMPILER:FILEPATH=.*[Cc][Ll]\\.exe$")
set(_runtime_options)
if(_msvc_entry)
    file(READ "${_relocated}/${_data_dir}/minuvex/sdk-manifest.json" _runtime_manifest)
    string(JSON _runtime_name GET "${_runtime_manifest}" runtime)
    list(APPEND _runtime_options "-DCMAKE_MSVC_RUNTIME_LIBRARY=${_runtime_name}")
    if(_runtime_name STREQUAL "MultiThreaded")
        set(_wrong_runtime MultiThreadedDLL)
    else()
        set(_wrong_runtime MultiThreaded)
    endif()
    expect_missing(runtime "1 COMPONENTS core" "set(CMAKE_CONFIGURATION_TYPES \"\")\nset(CMAKE_BUILD_TYPE ${CONFIG})\nset(CMAKE_MSVC_RUNTIME_LIBRARY ${_wrong_runtime})")
endif()
set(_recovery "${_root}/find-recovery")
file(MAKE_DIRECTORY "${_recovery}")
file(WRITE "${_recovery}/CMakeLists.txt" "cmake_minimum_required(VERSION 3.24)\nproject(SdkFindRecovery LANGUAGES CXX)\nfind_package(Minuvex 1 QUIET CONFIG COMPONENTS nonexistent)\nif(Minuvex_FOUND)\n message(FATAL_ERROR \"Unknown required component accepted\")\nendif()\nfind_package(Minuvex 1 CONFIG REQUIRED COMPONENTS core OPTIONAL_COMPONENTS nonexistent)\nif(NOT EXISTS \"\${Minuvex_DATA_DIR}/sdk-manifest.json\" OR NOT Minuvex_CONFIGURATIONS)\n message(FATAL_ERROR \"Missing relocated SDK metadata\")\nendif()\n")
run("${CMAKE_COMMAND}" -S "${_recovery}" -B "${_recovery}/build" -G "${GENERATOR}"
    "-DCMAKE_BUILD_TYPE=${CONFIG}" ${_runtime_options} "-DMinuvex_DIR=${_config_dir}" -DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF)
set(_share "${_relocated}/${_data_dir}/minuvex")
file(READ "${_share}/sdk-manifest.json" _manifest)
string(JSON _flavor GET "${_manifest}" flavor)
string(JSON _format GET "${_manifest}" format)
string(JSON _configuration GET "${_manifest}" configuration)
if(NOT _format STREQUAL "MinuvexSdk" OR NOT _configuration STREQUAL CONFIG)
    message(FATAL_ERROR "SDK manifest format/configuration does not match the payload.")
endif()
file(STRINGS "${BUILD_DIR}/CMakeCache.txt" _source_entry REGEX "^CMAKE_HOME_DIRECTORY:INTERNAL=")
string(REPLACE "CMAKE_HOME_DIRECTORY:INTERNAL=" "" _source_dir "${_source_entry}")
file(GLOB _headers "${_source_dir}/include/minuvex/*.h")
foreach(_header IN LISTS _headers)
    get_filename_component(_name "${_header}" NAME)
    file(GLOB_RECURSE _installed "${_relocated}/*/minuvex/${_name}")
    if(NOT _installed)
        message(FATAL_ERROR "Public SDK header is missing: ${_name}")
    endif()
endforeach()
foreach(_license versions.json cgltf-LICENSE json-LICENSE.MIT tinyobjloader-LICENSE ufbx-LICENSE meshoptimizer-LICENSE stb_image.h)
    if(NOT EXISTS "${_share}/licenses/${_license}")
        message(FATAL_ERROR "SDK dependency notice is missing: ${_license}")
    endif()
endforeach()
file(STRINGS "${BUILD_DIR}/CMakeCache.txt" _drafts REGEX "^MINUVEX_INSTALL_DRAFT_DOCS:BOOL=ON$")
file(GLOB_RECURSE _markdown "${_relocated}/*.md" "${_relocated}/*.MD")
if(_markdown AND NOT _drafts)
    message(FATAL_ERROR "Local Markdown drafts unexpectedly entered the SDK package.")
endif()
if(_flavor STREQUAL "cpu")
    expect_missing(cpu-graphics "1 COMPONENTS graphics")
elseif(NOT EXISTS "${_share}/licenses/sokol-LICENSE")
    message(FATAL_ERROR "Native SDK is missing its Sokol notice.")
endif()
set(_consumer "${_root}/consumer")
set(_options)
set(_config_options "-DCMAKE_BUILD_TYPE=${CONFIG}" ${_runtime_options})
if(GENERATOR MATCHES "Visual Studio|Xcode|Multi-Config")
    list(APPEND _config_options "-DCMAKE_CONFIGURATION_TYPES=${CONFIG}")
endif()
if(RUN_DESKTOP)
    list(APPEND _options -DMINUVEX_SDK_BUILD_VIEWER=ON -DMINUVEX_SDK_BUILD_EMBEDDED_HOST=ON)
endif()
if(NOT GENERATOR)
    set(GENERATOR Ninja)
endif()
run("${CMAKE_COMMAND}" -S "${_share}/examples/SdkConsumer" -B "${_consumer}"
    -G "${GENERATOR}" ${_config_options} "-DMinuvex_DIR=${_config_dir}"
    -DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF ${_options})
run("${CMAKE_COMMAND}" --build "${_consumer}" --config "${CONFIG}" --parallel 4)
set(_bin "${_consumer}")
if(WIN32)
    set(_exe .exe)
endif()
if(EXISTS "${_consumer}/${CONFIG}/minuvex_sdk_cpu${_exe}")
    set(_bin "${_consumer}/${CONFIG}")
endif()
set(_model "${_share}/examples/assets/SharedBox.glb")
run("${_bin}/minuvex_sdk_cpu${_exe}" "${_model}" "${_root}/output")
run("${_bin}/minuvex_sdk_animation${_exe}" "${_share}/examples/assets/AnimatedRibbon.gltf" "${_root}/output/Example.mvxpose.json")
if(RUN_DESKTOP)
    run("${_bin}/minuvex_sdk_viewer${_exe}" "${_model}")
    run("${_bin}/minuvex_sdk_effects${_exe}" --frames 3)
    run("${_bin}/minuvex_sdk_host${_exe}" --smoke-test)
endif()
if(RUN_BENCHMARK)
    set(_benchmark "${_root}/benchmark")
    run("${CMAKE_COMMAND}" -S "${_share}/benchmarks/Minuvex" -B "${_benchmark}" -G "${GENERATOR}"
        ${_config_options} "-DMinuvex_DIR=${_config_dir}")
    run("${CMAKE_COMMAND}" --build "${_benchmark}" --config "${CONFIG}" --parallel 4)
    set(_benchmark_bin "${_benchmark}")
    if(EXISTS "${_benchmark}/${CONFIG}/minuvex_benchmark${_exe}")
        set(_benchmark_bin "${_benchmark}/${CONFIG}")
    endif()
    run("${_benchmark_bin}/minuvex_benchmark${_exe}" --objects 1000 --warmup 60 --frames 240 --output "${_root}/benchmark.json")
endif()
if(PACKAGE)
    message(STATUS "Verified SDK archive and SHA-256: ${_archive}")
endif()
message(STATUS "Relocated SDK and independent consumer verified: ${_relocated}")
