# Embed the checked-in icon sizes so SDK consumers need no runtime image files.
set(_minuvex_brand_dir "${PROJECT_SOURCE_DIR}/assets/branding")
set(_minuvex_icon_header "#pragma once\n#include <cstddef>\nnamespace lv::detail::branding {\n")
foreach(_size IN ITEMS 16 32 64 256)
    set(_png "${_minuvex_brand_dir}/Minvex_icon_${_size}.png")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_png}")
    file(READ "${_png}" _bytes HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_bytes}")
    string(APPEND _minuvex_icon_header "inline constexpr unsigned char Icon${_size}[] = {${_bytes}};\n")
endforeach()
string(APPEND _minuvex_icon_header "struct IconSource { const unsigned char* Data; std::size_t Size; };\ninline constexpr IconSource Icons[] = {\n")
foreach(_size IN ITEMS 16 32 64 256)
    string(APPEND _minuvex_icon_header "{Icon${_size}, sizeof(Icon${_size})},\n")
endforeach()
string(APPEND _minuvex_icon_header "};\n}\n")
file(CONFIGURE OUTPUT "${PROJECT_BINARY_DIR}/generated/WindowIconData.h" CONTENT "${_minuvex_icon_header}" @ONLY)

if(WIN32)
    enable_language(RC)
    file(CONFIGURE OUTPUT "${PROJECT_BINARY_DIR}/generated/MinuvexIcon.rc"
        CONTENT "1 ICON \"${_minuvex_brand_dir}/Minvex.ico\"\n" @ONLY)
endif()

function(minuvex_brand_executable target)
    if(WIN32)
        target_sources(${target} PRIVATE "${PROJECT_BINARY_DIR}/generated/MinuvexIcon.rc")
    endif()
endfunction()
