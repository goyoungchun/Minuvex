@PACKAGE_INIT@
set(Minuvex_FOUND TRUE)
unset(Minuvex_NOT_FOUND_MESSAGE)
include(CMakeFindDependencyMacro)
find_dependency(Threads)
set(Minuvex_VERSION "@PROJECT_VERSION@")
set(Minuvex_GRAPHICS_AVAILABLE @MINUVEX_BUILD_RENDERER@)
set(Minuvex_COMPILER "@CMAKE_CXX_COMPILER_ID@-@CMAKE_CXX_COMPILER_VERSION@")
set(Minuvex_MSVC_RUNTIME_LIBRARY "@MINUVEX_SDK_RUNTIME@")
set(Minuvex_POINTER_BYTES @CMAKE_SIZEOF_VOID_P@)
set_and_check(Minuvex_DATA_DIR "@PACKAGE_CMAKE_INSTALL_DATADIR@/minuvex")
if(DEFINED CMAKE_SIZEOF_VOID_P AND NOT CMAKE_SIZEOF_VOID_P EQUAL Minuvex_POINTER_BYTES)
    set(Minuvex_FOUND FALSE)
    set(Minuvex_NOT_FOUND_MESSAGE "Minuvex pointer width differs from the consumer; install a matching architecture SDK.")
    return()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/MinuvexTargets.cmake")
get_target_property(Minuvex_CONFIGURATIONS minuvex::core IMPORTED_CONFIGURATIONS)
if(NOT CMAKE_CONFIGURATION_TYPES AND CMAKE_BUILD_TYPE)
    string(TOUPPER "${CMAKE_BUILD_TYPE}" _Minuvex_config)
    if(NOT _Minuvex_config IN_LIST Minuvex_CONFIGURATIONS)
        set(Minuvex_FOUND FALSE)
        set(Minuvex_NOT_FOUND_MESSAGE "Minuvex has configurations ${Minuvex_CONFIGURATIONS}; select a matching CMAKE_BUILD_TYPE or install that configuration.")
        return()
    endif()
    # Resolve the normal default expression. Custom consumer expressions remain
    # the caller's ABI responsibility; CMake evaluates those per target/config.
    if(MSVC)
        set(_Minuvex_runtime "${Minuvex_MSVC_RUNTIME_LIBRARY}")
        set(_Minuvex_consumer_runtime "${CMAKE_MSVC_RUNTIME_LIBRARY}")
        foreach(_runtime _Minuvex_runtime _Minuvex_consumer_runtime)
            if(NOT ${_runtime} OR "${${_runtime}}" STREQUAL "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
                if(_Minuvex_config STREQUAL "DEBUG")
                    set(${_runtime} MultiThreadedDebugDLL)
                else()
                    set(${_runtime} MultiThreadedDLL)
                endif()
            endif()
        endforeach()
        if(NOT _Minuvex_runtime MATCHES "\\$<" AND NOT _Minuvex_consumer_runtime MATCHES "\\$<" AND NOT _Minuvex_runtime STREQUAL _Minuvex_consumer_runtime)
            set(Minuvex_FOUND FALSE)
            set(Minuvex_NOT_FOUND_MESSAGE "Minuvex MSVC runtime ${_Minuvex_runtime} differs from consumer ${_Minuvex_consumer_runtime}; rebuild with the same C++ runtime.")
            return()
        endif()
    endif()
endif()
set(_Minuvex_components core animation assets scene scene_io quality telemetry debug optimization editor_document viewer embedded)
foreach(_component IN LISTS _Minuvex_components)
    set(Minuvex_${_component}_FOUND TRUE)
endforeach()
# viewer/embedded are also available as CPU stubs. Request graphics explicitly
# when the application requires a native runtime rather than just CPU APIs.
set(Minuvex_graphics_FOUND ${Minuvex_GRAPHICS_AVAILABLE})
foreach(_component IN LISTS Minuvex_FIND_COMPONENTS)
    if(NOT _component IN_LIST _Minuvex_components AND NOT _component STREQUAL "graphics")
        set(Minuvex_${_component}_FOUND FALSE)
        set(Minuvex_NOT_FOUND_MESSAGE "Unknown Minuvex component: ${_component}")
    elseif(_component STREQUAL "graphics" AND NOT Minuvex_GRAPHICS_AVAILABLE)
        set(Minuvex_NOT_FOUND_MESSAGE "This is a CPU-only SDK; install a native SDK to request graphics.")
    endif()
endforeach()
check_required_components(Minuvex)
unset(_component)
unset(_Minuvex_components)
