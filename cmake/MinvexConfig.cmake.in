@PACKAGE_INIT@
set(Minvex_FOUND TRUE)
unset(Minvex_NOT_FOUND_MESSAGE)
include(CMakeFindDependencyMacro)
find_dependency(Threads)
set(Minvex_VERSION "@PROJECT_VERSION@")
set(Minvex_GRAPHICS_AVAILABLE @MINVEX_BUILD_RENDERER@)
set(Minvex_COMPILER "@CMAKE_CXX_COMPILER_ID@-@CMAKE_CXX_COMPILER_VERSION@")
set(Minvex_MSVC_RUNTIME_LIBRARY "@MINVEX_SDK_RUNTIME@")
set(Minvex_POINTER_BYTES @CMAKE_SIZEOF_VOID_P@)
set_and_check(Minvex_DATA_DIR "@PACKAGE_CMAKE_INSTALL_DATADIR@/minvex")
if(DEFINED CMAKE_SIZEOF_VOID_P AND NOT CMAKE_SIZEOF_VOID_P EQUAL Minvex_POINTER_BYTES)
    set(Minvex_FOUND FALSE)
    set(Minvex_NOT_FOUND_MESSAGE "Minvex pointer width differs from the consumer; install a matching architecture SDK.")
    return()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/MinvexTargets.cmake")
get_target_property(Minvex_CONFIGURATIONS minvex::core IMPORTED_CONFIGURATIONS)
if(NOT CMAKE_CONFIGURATION_TYPES AND CMAKE_BUILD_TYPE)
    string(TOUPPER "${CMAKE_BUILD_TYPE}" _Minvex_config)
    if(NOT _Minvex_config IN_LIST Minvex_CONFIGURATIONS)
        set(Minvex_FOUND FALSE)
        set(Minvex_NOT_FOUND_MESSAGE "Minvex has configurations ${Minvex_CONFIGURATIONS}; select a matching CMAKE_BUILD_TYPE or install that configuration.")
        return()
    endif()
    # Resolve the normal default expression. Custom consumer expressions remain
    # the caller's ABI responsibility; CMake evaluates those per target/config.
    if(MSVC)
        set(_Minvex_runtime "${Minvex_MSVC_RUNTIME_LIBRARY}")
        set(_Minvex_consumer_runtime "${CMAKE_MSVC_RUNTIME_LIBRARY}")
        foreach(_runtime _Minvex_runtime _Minvex_consumer_runtime)
            if(NOT ${_runtime} OR "${${_runtime}}" STREQUAL "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
                if(_Minvex_config STREQUAL "DEBUG")
                    set(${_runtime} MultiThreadedDebugDLL)
                else()
                    set(${_runtime} MultiThreadedDLL)
                endif()
            endif()
        endforeach()
        if(NOT _Minvex_runtime MATCHES "\\$<" AND NOT _Minvex_consumer_runtime MATCHES "\\$<" AND NOT _Minvex_runtime STREQUAL _Minvex_consumer_runtime)
            set(Minvex_FOUND FALSE)
            set(Minvex_NOT_FOUND_MESSAGE "Minvex MSVC runtime ${_Minvex_runtime} differs from consumer ${_Minvex_consumer_runtime}; rebuild with the same C++ runtime.")
            return()
        endif()
    endif()
endif()
set(_Minvex_components core animation assets scene scene_io quality telemetry debug optimization editor_document viewer embedded)
foreach(_component IN LISTS _Minvex_components)
    set(Minvex_${_component}_FOUND TRUE)
endforeach()
# viewer/embedded are also available as CPU stubs. Request graphics explicitly
# when the application requires a native runtime rather than just CPU APIs.
set(Minvex_graphics_FOUND ${Minvex_GRAPHICS_AVAILABLE})
foreach(_component IN LISTS Minvex_FIND_COMPONENTS)
    if(NOT _component IN_LIST _Minvex_components AND NOT _component STREQUAL "graphics")
        set(Minvex_${_component}_FOUND FALSE)
        set(Minvex_NOT_FOUND_MESSAGE "Unknown Minvex component: ${_component}")
    elseif(_component STREQUAL "graphics" AND NOT Minvex_GRAPHICS_AVAILABLE)
        set(Minvex_NOT_FOUND_MESSAGE "This is a CPU-only SDK; install a native SDK to request graphics.")
    endif()
endforeach()
check_required_components(Minvex)
unset(_component)
unset(_Minvex_components)
